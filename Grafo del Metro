def construir_grafo_metro() -> nx.Graph:
    """
    Nodo -> atributo 'lineas' (conjunto de líneas que pasan por ahí).   Arista -> 'lineas', 'color', 'distancia_km', 'tiempo_min' y 'weight'
    (weight = tiempo_min, para que funcione directo con los algoritmos de NetworkX que buscan el atributo 'weight' por default).
    """
    G = nx.Graph()

    for nombre_linea, datos in LINEAS.items():
        estaciones = datos["estaciones"]
        color = datos["color"]
        n_tramos = len(estaciones) - 1
        distancia_prom_km = datos["longitud_km"] / n_tramos
        tiempo_prom_min = distancia_prom_km / VELOCIDAD_COMERCIAL_KMH * 60

        for estacion in estaciones:
            if G.has_node(estacion):
                G.nodes[estacion]["lineas"].add(nombre_linea)
            else:
                G.add_node(estacion, lineas={nombre_linea})

        for origen, destino in zip(estaciones, estaciones[1:]):
            if G.has_edge(origen, destino):
                # Tramo ya existente en otra línea: se promedian los pesos y se registra que por ahí pasa también esta línea.
                arista = G.edges[origen, destino]
                arista["lineas"].add(nombre_linea)
                arista["distancia_km"] = round(
                    (arista["distancia_km"] + distancia_prom_km) / 2, 3
                )
                arista["tiempo_min"] = round(
                    (arista["tiempo_min"] + tiempo_prom_min) / 2, 2
                )
                arista["weight"] = arista["tiempo_min"]
            else:
                G.add_edge(
                    origen, destino,
                    lineas={nombre_linea},
                    color=color,
                    distancia_km=round(distancia_prom_km, 3),
                    tiempo_min=round(tiempo_prom_min, 2),
                    weight=round(tiempo_prom_min, 2),
                )

    return G


def estaciones_de_transbordo(G: nx.Graph) -> dict:
    # Regresa {estacion: {lineas}} para las estaciones con más de una línea.
    return {n: d["lineas"] for n, d in G.nodes(data=True) if len(d["lineas"]) > 1}


def _imprimir_ruta(G: nx.Graph, camino: list[str]) -> None:
    for i, estacion in enumerate(camino, start=1):
        lineas = ", ".join(sorted(G.nodes[estacion]["lineas"]))
        marca = " <-- transbordo" if len(G.nodes[estacion]["lineas"]) > 1 else ""
        print(f"  {i}. {estacion}  ({lineas}){marca}")


def ruta_mas_corta(G: nx.Graph, origen: str, destino: str) -> list[str]:
    # Ruta con menor número de estaciones entre origen y destino (sin pesos).
    camino = nx.shortest_path(G, origen, destino)
    print(f"\nRuta más corta (por número de estaciones) de '{origen}' a '{destino}':")
    print(f"  {len(camino) - 1} tramos")
    _imprimir_ruta(G, camino)
    return camino


def ruta_mas_rapida(G: nx.Graph, origen: str, destino: str, peso: str = "tiempo_min"):
    # Ruta que minimiza el peso indicado (Dijkstra). Por defecto, tiempo_min.
    camino = nx.dijkstra_path(G, origen, destino, weight=peso)
    total = nx.dijkstra_path_length(G, origen, destino, weight=peso)
    unidad = "min" if peso == "tiempo_min" else "km"
    print(f"\nRuta más rápida (por '{peso}') de '{origen}' a '{destino}': "
          f"{total:.1f} {unidad} (sin contar transbordos)")
    _imprimir_ruta(G, camino)
    return camino, total


def tiempo_de_viaje(
    G: nx.Graph, camino: list[str], penalizacion_transbordo: float = PENALIZACION_TRANSBORDO_MIN
) -> float:
    """Suma 'tiempo_min' a lo largo de un camino ya calculado y agrega una penalización fija cada vez que, entre un tramo y 
    el siguiente, no hay ninguna línea en común (es decir, hubo que hacer transbordo)."""
    total = 0.0
    lineas_tramo_anterior = None
    for origen, destino in zip(camino, camino[1:]):
        arista = G.edges[origen, destino]
        total += arista["tiempo_min"]
        lineas_tramo = arista["lineas"]
        if lineas_tramo_anterior is not None and lineas_tramo_anterior.isdisjoint(lineas_tramo):
            total += penalizacion_transbordo
        lineas_tramo_anterior = lineas_tramo
    return round(total, 1)


def dibujar_grafo(G: nx.Graph, archivo: str = "metro_cdmx_grafo.png") -> None:
    #Dibuja el grafo completo, coloreando cada arista según su línea.
    plt.figure(figsize=(24, 18))
    pos = nx.kamada_kawai_layout(G)

    for u, v, datos in G.edges(data=True):
        nx.draw_networkx_edges(
            G, pos, edgelist=[(u, v)], edge_color=datos["color"], width=2.2
        )

    transbordos = estaciones_de_transbordo(G)
    tamanos = [260 if n in transbordos else 50 for n in G.nodes()]
    colores_nodo = ["white" if n in transbordos else "black" for n in G.nodes()]

    nx.draw_networkx_nodes(
        G, pos, node_size=tamanos, node_color=colores_nodo,
        edgecolors="black", linewidths=0.8,
    )
    nx.draw_networkx_labels(
        G, pos, labels={n: n for n in transbordos}, font_size=6
    )

    plt.title("Red del Metro de la Ciudad de México (grafo NetworkX, con pesos)", fontsize=18)
    plt.axis("off")
    plt.tight_layout()
    plt.savefig(archivo, dpi=200)
    print(f"\nImagen guardada en: {archivo}")


